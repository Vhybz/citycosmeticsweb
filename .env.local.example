# Supabase Configuration
# Replace these with your project credentials from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Ghana SMS Providers for Dispatch Alerts to 0503574865
# (Optional - provider is auto-detected if any key is filled)
MNOTIFY_API_KEY=your_mnotify_api_key_here
MNOTIFY_SENDER_ID=CityCosmet
# Or Arkesel Ghana:
# ARKESEL_API_KEY=your_arkesel_api_key_here
# ARKESEL_SENDER_ID=CityCosmetics
# Or Hubtel Ghana:
# HUBTEL_CLIENT_ID=your_hubtel_client_id
# HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

